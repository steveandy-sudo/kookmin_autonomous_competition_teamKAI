Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Camera rosbag1
        - /Camera with SEG-ROW-NEW path1
        - /SEG canonical 1.5m1
        - /ROW canonical 1.5m1
        - /NEW canonical 2.5m1
        - /SEG steering path1
        - /ROW steering path1
        - /NEW steering path1
      Splitter Ratio: 0.5
    Tree Height: 371
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: Camera rosbag
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /wide_camera_mjpeg/image_raw/compressed
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: Camera with SEG-ROW-NEW path
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/camera_path_overlay
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: SEG canonical 1.5m
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/seg/canonical
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: ROW canonical 1.5m
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/row/canonical
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: NEW canonical 2.5m
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/new/canonical
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: SEG steering path
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/seg/controller_debug
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: ROW steering path
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/row/controller_debug
      Value: false
    - Class: rviz_default_plugins/Image
      Enabled: false
      Max Value: 255
      Median window: 5
      Min Value: 0
      Name: NEW steering path
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /comparison/new/controller_debug
      Value: false
  Enabled: true
  Global Options:
    Background Color: 34; 36; 40
    Fixed Frame: base_footprint
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: -0.38960179686546326
      Target Frame: base_footprint
      Value: Orbit (rviz)
      Yaw: 0.8953981399536133
    Saved: ~
Window Geometry:
  Camera rosbag:
    collapsed: false
  Camera with SEG-ROW-NEW path:
    collapsed: false
  Displays:
    collapsed: false
  Height: 504
  Hide Left Dock: false
  Hide Right Dock: false
  NEW canonical 2.5m:
    collapsed: false
  NEW steering path:
    collapsed: false
  QMainWindow State: 
  ROW canonical 1.5m:
    collapsed: false
  ROW steering path:
    collapsed: false
  SEG canonical 1.5m:
    collapsed: false
  SEG steering path:
    collapsed: false
  Width: 927
