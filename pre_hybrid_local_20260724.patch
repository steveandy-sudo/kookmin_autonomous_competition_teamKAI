+def offset_target_path_lateral(
+    path: np.ndarray,
+    target_lateral_offset_m: float,
+) -> np.ndarray:
+    """Shift a completed target path; positive is vehicle-left."""
+    points = np.asarray(path, dtype=np.float64)
+    if points.ndim != 2 or points.shape[0] < 2 or points.shape[1] != 2:
+        return np.empty((0, 2), dtype=np.float64)
+    result = points.copy()
+    result[:, 1] += float(target_lateral_offset_m)
+    return result
+
