+def shift_canonical_image_for_target(
+    image_bgr: np.ndarray,
+    target_lateral_offset_m: float,
+    lateral_range_m: float,
+    background_gray: int,
+) -> np.ndarray:
+    """Shift canonical features so positive offset targets vehicle-left."""
+    image = np.asarray(image_bgr)
+    if image.ndim not in (2, 3) or image.shape[1] <= 0:
+        raise ValueError("canonical image must have a non-empty width")
+    lateral_range = float(lateral_range_m)
+    if lateral_range <= 0.0:
+        raise ValueError("canonical lateral range must be positive")
+
+    # A left-shifted road makes the policy steer left until the real road
+    # appears equally far right, placing the vehicle at the requested offset.
+    pixel_shift = int(
+        round(
+            -float(target_lateral_offset_m)
+            * float(image.shape[1])
+            / lateral_range
+        )
+    )
+    if pixel_shift == 0:
+        return image.copy()
+
+    fill = int(np.clip(background_gray, 0, 255))
+    shifted = np.full_like(image, fill)
+    width = int(image.shape[1])
+    if abs(pixel_shift) >= width:
+        return shifted
+    if pixel_shift > 0:
+        shifted[:, pixel_shift:] = image[:, : width - pixel_shift]
+    else:
+        shift_left = -pixel_shift
+        shifted[:, : width - shift_left] = image[:, shift_left:]
+    return shifted
+
+
+def inference_frame_due(
+    now_sec: float,
+    last_sec: float,
+    maximum_rate_hz: float,
+    slack_sec: float,
+) -> bool:
+    """Return true when a frame should run; a non-positive rate is source-driven."""
+    if maximum_rate_hz <= 0.0 or last_sec <= 0.0:
+        return True
+    minimum_interval = max(
+        0.0,
+        1.0 / maximum_rate_hz - max(0.0, slack_sec),
+    )
+    return now_sec - last_sec >= minimum_interval
+
+
+def temporal_pair_requires_reset(
+    current_stamp_ns: int,
+    previous_stamp_ns: int,
+    maximum_gap_sec: float,
+) -> bool:
+    if current_stamp_ns <= 0 or previous_stamp_ns <= 0:
+        return False
+    gap_sec = (current_stamp_ns - previous_stamp_ns) / 1.0e9
+    return gap_sec <= 0.0 or (
+        maximum_gap_sec > 0.0 and gap_sec > maximum_gap_sec
+    )
+
