<?xml version="1.0"?>
<package format="3">
  <name>xycar_map_nav</name>
  <version>0.2.0</version>
  <description>RULE, cone, and YOLO-LiDAR avoidance arbitration for Xycar.</description>
  <maintainer email="team.kai@example.com">Team K.A.I.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lane_seg_control</exec_depend>
  <exec_depend>my_rule</exec_depend>
  <exec_depend>my_rule_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>wide_camera</exec_depend>
  <exec_depend>xycar_lidar</exec_depend>
  <exec_depend>xycar_rule_drive</exec_depend>
  <exec_depend>xycar_rl</exec_depend>
  <exec_depend>xycar_vesc_driver</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
