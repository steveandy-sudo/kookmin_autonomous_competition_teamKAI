<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"?>
<package format="3">
  <name>xycar_final_drive</name>
  <version>0.1.0</version>
  <description>Real-car launch selector for the final Kookmin rule and RL drivers.</description>
  <maintainer email="team.kai@example.com">Team K.A.I.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lane_seg_control</exec_depend>
  <exec_depend>wide_camera</exec_depend>
  <exec_depend>xycar_lidar</exec_depend>
  <exec_depend>xycar_rl</exec_depend>
  <exec_depend>xycar_rule_drive</exec_depend>
  <exec_depend>xycar_hybrid_drive</exec_depend>
  <exec_depend>xycar_vesc_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
