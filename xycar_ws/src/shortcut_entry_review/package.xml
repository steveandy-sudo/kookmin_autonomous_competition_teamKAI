<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>shortcut_entry_review</name>
  <version>0.1.0</version>
  <description>Sequence-aware W1 shortcut entry without direct motor output.</description>
  <maintainer email="kai@example.com">kai</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>kaiev26_msgs</exec_depend>
  <exec_depend>lane_seg_control</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>track_drive_sve</exec_depend>
  <exec_depend>xycar_perception</exec_depend>
  <exec_depend>xycar_rule_drive</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
