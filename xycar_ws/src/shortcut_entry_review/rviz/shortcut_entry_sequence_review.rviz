Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /W1 Y1 Selection1
        - /Canonical White Yellow Input1
        - /left_4 Detection1
        - /Controller Path1
      Splitter Ratio: 0.52
    Tree Height: 640
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: W1 Y1 Selection
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut/entry/debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Canonical White Yellow Input
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut/entry/canonical_model_input
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: left_4 Detection
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut/review/object_debug_image
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Controller Path
      Namespaces: {}
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /shortcut/entry/controller_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 32; 36
    Fixed Frame: base_footprint
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 500
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0.75
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1500
  X: 70
  Y: 45
