Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /YOLO Lane Detection1
        - /Model Camera1
        - /Canonical Model Input1
        - /Object Detection1
        - /White Yellow Entry Path1
        - /Sequence W1 Y1 Selection1
        - /Sequence Canonical Input1
        - /Semantic BEV Image1
        - /Semantic BEV Click Surface1
        - /Clicked Line Segments1
      Splitter Ratio: 0.5
    Tree Height: 164
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: YOLO Lane Detection
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut_review/lane_seg/debug_image
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: rgb
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Semantic BEV Click Surface
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.012
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /shortcut_annotation/semantic_bev_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Clicked Line Segments
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /shortcut_annotation/line_markers
      Value: true
    - Cell Size: 0.1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 95
      Enabled: true
      Line Style:
        Line Width: 0.01
        Value: Lines
      Name: BEV Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: -0.01
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.25
      Name: Vehicle Origin
      Radius: 0.015
      Reference Frame: base_footprint
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: White Yellow Entry Path
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut_review/entry/debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Sequence W1 Y1 Selection
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut/entry/debug_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Sequence Canonical Input
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut/entry/canonical_model_input
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Semantic BEV Image
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /shortcut_annotation/semantic_bev_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Model Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut_review/lane_seg/source_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Canonical Model Input
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut_review/canonical_road_image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Object Detection
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /shortcut_review/object_detection/debug_image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 34; 36; 40
    Fixed Frame: base_footprint
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz_default_plugins/TopDownOrtho
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 500
      Target Frame: base_footprint
      Value: TopDownOrtho (rviz_default_plugins)
      X: 0.75
      Y: 0
    Saved: ~
Window Geometry:
  Canonical Model Input:
    collapsed: false
  Displays:
    collapsed: false
  Height: 820
  Hide Left Dock: false
  Hide Right Dock: false
  Model Camera:
    collapsed: false
  Object Detection:
    collapsed: false
  QMainWindow State: 
  Width: 1280
  X: 115
  Y: 72
  YOLO Lane Detection:
    collapsed: false
